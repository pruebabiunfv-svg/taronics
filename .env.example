# Ejemplo — deben establecerse en el servidor, NO registrar en git
CALIBPRO_ENV=production
SECRET_KEY=REEMPLAZAR_POR_64_CARACTERES_GENERADOS
DATABASE_PATH=/app/instance/calibpro.db
UPLOAD_FOLDER=/app/instance/uploads/photos
ALLOW_PUBLIC_REGISTRATION=false
SEED_CATALOG_EXAMPLES=false  # true SOLO en desarrollo para desplegables de ejemplo
SEED_DEMO_DATA=false
REGISTRATION_CODE=
# MAIL_USERNAME=
# MAIL_PASSWORD=

# URL que aparecerá en QR: HTTPS y DNS público válido en producción
PUBLIC_BASE_URL=https://calibraciones.tu-empresa.pe

# Credenciales de Gmail SMTP (guardar en secreto, no en el repositorio)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Firma criptográfica PDF PKCS#12 (opcional)
PDF_SIGN_P12_PATH=
PDF_SIGN_P12_PASSWORD=
